// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`email renderer > matches the snapshot 1`] = `
"<div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:26px;font-weight:700;line-height:1.25;margin:0 0 14px;">Hi {{first_name}}</div>
{{#if tag:vip}}<p style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;margin:0 0 16px;"><strong>Bold </strong><a href="https://example.com/?a=1&amp;b={{email}}" style="color:#2563eb;text-decoration:underline;"><em>link</em></a><br><u>{{company.name|your team}}</u><s><code style="font-family:ui-monospace,Menlo,Consolas,monospace;font-size:14px;background:#f4f4f5;padding:1px 5px;border-radius:4px;"> code</code></s></p>{{/if}}
<ol style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;margin:0 0 16px;padding-left:22px;"><li style="margin:0 0 8px;">one</li><li style="margin:0 0 8px;">{{field:Report URL}}</li></ol>
<blockquote style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;margin:0 0 16px;padding:4px 0 4px 16px;border-left:3px solid #e5e7eb;color:#57606a;">quoted</blockquote>
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 16px;"><tr><td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;background:#f4f4f5;border-radius:8px;padding:14px 16px;">note</td></tr></table>
<div style="border-top:1px solid #e5e7eb;margin:24px 0;font-size:0;line-height:0;">&nbsp;</div>
<div style="margin:0 0 16px;"><a href="https://x.test"><img src="https://cdn.test/a.png" alt="A" width="300" style="display:block;width:100%;max-width:300px;height:auto;border-radius:6px;"></a></div>
<table role="presentation" border="0" cellpadding="0" cellspacing="0" align="right" style="margin:8px 0 18px auto;"><tr><td style="background:#2563eb;border-radius:8px;font-size:16px;line-height:20px;"><a href="{{field:report_url}}" style="display:inline-block;padding:11px 22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;font-weight:600;line-height:20px;color:#ffffff;text-decoration:none;">Go</a></td></tr></table>
<div style="height:56px;font-size:0;line-height:0;">&nbsp;</div>
<div style="text-align:left;font-size:0;margin:0 0 16px;"><div class="stack" style="display:inline-block;width:100%;max-width:288px;vertical-align:top;"><div style="padding:0 6px;font-size:16px;line-height:1.6;"><p style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;margin:0 0 16px;">left</p></div></div><div class="stack" style="display:inline-block;width:100%;max-width:288px;vertical-align:top;"><div style="padding:0 6px;font-size:16px;line-height:1.6;"><table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center" style="margin:8px auto 18px;"><tr><td style="background:#2563eb;border-radius:8px;font-size:16px;line-height:20px;"><a href="mailto:a@b.co" style="display:inline-block;padding:11px 22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;font-weight:600;line-height:20px;color:#ffffff;text-decoration:none;">B</a></td></tr></table></div></div></div>"
`;
