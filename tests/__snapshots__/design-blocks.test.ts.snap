exports[`email renderer > button + text link: two inline-blocks that stack when narrow 1`] = `"<div style="text-align:left;font-size:0;line-height:0;margin:8px 0 8px;"><div class="ds-cta" style="display:inline-block;vertical-align:middle;margin:0 24px 10px 0;"><table role="presentation" border="0" cellpadding="0" cellspacing="0"><tr><td style="background:#2563eb;border-radius:8px;font-size:16px;line-height:20px;"><a href="https://example.com/book/" style="display:inline-block;padding:11px 22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;font-weight:600;line-height:20px;color:#ffffff;text-decoration:none;">Book a call</a></td></tr></table></div><div class="ds-cta-link" style="display:inline-block;vertical-align:middle;margin:0 0 10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;font-weight:600;line-height:1.4;"><a href="mailto:hello@example.com" style="font-size:16px;line-height:1.4;color:#2563eb;text-decoration:underline;">or reply</a></div></div>"`;

